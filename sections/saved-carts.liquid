{% comment %}
  Saved carts for B2B customers. Used by templates/page.saved-carts.json; assign that template to a page in the admin.
  Carts are stored in the customer's account through the saved-carts app proxy (see saved-carts-app/).
{% endcomment %}

<div class="saved-carts-intro">
  <p class="eyebrow">{{ 'saved_carts.eyebrow' | t }}</p>
  <h1>{{ page.title }}</h1>
  {% if page.content != blank %}
    <div class="muted">{{ page.content }}</div>
  {% endif %}
</div>

{% if customer == blank %}
  <div class="saved-carts-gate card">
    <p>{{ 'saved_carts.login_required' | t }}</p>
    <a class="button" href="{{ routes.account_login_url }}">{{ 'saved_carts.login' | t }}</a>
  </div>
{% elsif customer.b2b? == false %}
  <div class="saved-carts-gate card">
    <p>{{ 'saved_carts.b2b_only' | t }}</p>
  </div>
{% else %}
  <div
    class="saved-carts"
    data-saved-carts
    data-api-url="/apps/saved-carts/carts"
    data-cart-url="{{ routes.cart_url }}"
    data-cart-add-url="{{ routes.cart_add_url }}"
    data-cart-clear-url="{{ routes.cart_clear_url }}"
  >
    <aside class="saved-carts__current card">
    <h2>{{ 'saved_carts.current_cart' | t }}</h2>

    {% if cart.item_count > 0 %}
      <ul class="saved-carts__lines">
        {% for item in cart.items %}
          <li><span class="saved-carts__qty">{{ item.quantity }}×</span> {{ item.title }}</li>
        {% endfor %}
      </ul>
      <p class="saved-carts__total">
        <span class="muted">{{ 'cart.subtotal' | t }}</span> <strong>{{ cart.total_price | money }}</strong>
      </p>

      <form class="saved-carts__save" data-save-cart>
        <label for="SavedCartName">{{ 'saved_carts.name_label' | t }}</label>
        <input type="text" id="SavedCartName" name="name" maxlength="100" required>
        <button type="submit">{{ 'saved_carts.save' | t }}</button>
      </form>

      <script type="application/json" data-current-cart>
        [
          {%- for item in cart.items -%}
            {"id": {{ item.variant_id }}, "quantity": {{ item.quantity }}, "title": {{ item.title | json }}, "properties": {{ item.properties | json }}}
            {%- unless forloop.last %},{% endunless -%}
          {%- endfor -%}
        ]
      </script>
    {% else %}
      <p class="muted">{{ 'saved_carts.current_cart_empty' | t }}</p>
      <a class="button button--secondary" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue_shopping' | t }}</a>
    {% endif %}
    </aside>

    <section class="saved-carts__saved" aria-labelledby="SavedCartsTitle">
      <h2 id="SavedCartsTitle">{{ 'saved_carts.title' | t }}</h2>
      <p class="muted" data-loading>{{ 'saved_carts.loading' | t }}</p>
      <div class="saved-carts__empty card" data-empty hidden>
        <p>{{ 'saved_carts.empty' | t }}</p>
      </div>
      <ul class="saved-carts__list" data-list aria-live="polite"></ul>
    </section>

    <template data-row-template>
      <li class="saved-cart card">
        <div data-view>
          <div class="saved-cart__header">
            <h3 data-name></h3>
            <p class="saved-cart__meta muted" data-updated></p>
          </div>
          <ul class="saved-cart__items" data-items></ul>
          <div class="saved-cart__actions">
            <button type="button" data-action="checkout">{{ 'saved_carts.checkout' | t }}</button>
            <button class="button--secondary" type="button" data-action="restore">{{ 'saved_carts.restore' | t }}</button>
            <button class="button--secondary" type="button" data-action="edit">{{ 'saved_carts.edit' | t }}</button>
            <button class="button--danger" type="button" data-action="delete">{{ 'saved_carts.delete' | t }}</button>
          </div>
        </div>

        <form class="saved-cart__edit" data-edit hidden>
          <label class="saved-cart__field">
            {{ 'saved_carts.name_label' | t }}
            <input type="text" name="name" maxlength="100" required>
          </label>
          <ul class="saved-cart__edit-items" data-edit-items></ul>
          <div class="saved-cart__actions">
            <button type="submit">{{ 'saved_carts.save_changes' | t }}</button>
            <button class="button--secondary" type="button" data-action="cancel">{{ 'saved_carts.cancel' | t }}</button>
          </div>
        </form>
      </li>
    </template>

    <template data-edit-item-template>
      <li class="saved-cart__edit-item">
        <span data-title></span>
        <input
          type="number"
          name="quantity"
          min="1"
          max="10000"
          step="1"
          required
          aria-label="{{ 'saved_carts.quantity' | t }}"
        >
        <button class="button--danger" type="button" data-action="remove-item">{{ 'saved_carts.remove_item' | t }}</button>
      </li>
    </template>

    <div class="toasts" role="status" data-status></div>

    <template data-toast-template>
      <div class="toast">
        <p class="toast__text" data-toast-text></p>
        <button class="toast__close" type="button" aria-label="{{ 'saved_carts.dismiss' | t }}">&times;</button>
      </div>
    </template>

    <dialog class="confirm-dialog card" data-confirm aria-labelledby="SavedCartsConfirmText">
      <form method="dialog">
        <p id="SavedCartsConfirmText" data-confirm-text></p>
        <div class="confirm-dialog__actions">
          <button class="button--secondary" value="cancel">{{ 'saved_carts.cancel' | t }}</button>
          <button value="confirm" data-confirm-button></button>
        </div>
      </form>
    </dialog>

    <template data-messages>
      <span data-msg="updated-at">{{ 'saved_carts.updated_at' | t: date: '__date__' }}</span>
      <span data-msg="saved">{{ 'saved_carts.saved' | t }}</span>
      <span data-msg="updated">{{ 'saved_carts.updated' | t }}</span>
      <span data-msg="deleted">{{ 'saved_carts.deleted' | t }}</span>
      <span data-msg="delete-confirm">{{ 'saved_carts.delete_confirm' | t }}</span>
      <span data-msg="restore-confirm">{{ 'saved_carts.restore_confirm' | t }}</span>
      <span data-msg="empty-items">{{ 'saved_carts.empty_items' | t }}</span>
      <span data-msg="restore-adjusted">{{ 'saved_carts.restore_adjusted' | t }}</span>
      <span data-msg="restore-adjusted-line">{{ 'saved_carts.restore_adjusted_line' | t: title: '__title__', requested: '__requested__', added: '__added__' }}</span>
      <span data-msg="restore-error">{{ 'saved_carts.restore_error' | t }}</span>
      <span data-msg="conflict">{{ 'saved_carts.conflict' | t }}</span>
      <span data-msg="error">{{ 'saved_carts.error' | t }}</span>
    </template>

    <form action="{{ routes.cart_url }}" method="post" hidden data-checkout-form>
      <input type="hidden" name="checkout" value="1">
    </form>
  </div>

  <script src="{{ 'saved-carts.js' | asset_url }}" type="module"></script>
{% endif %}

{% stylesheet %}
  .saved-carts-intro h1 {
    margin-block: 0.5rem 0.75rem;
  }

  .saved-carts-intro {
    margin-block: 2.5rem 2rem;
  }

  .saved-carts-gate {
    display: grid;
    justify-items: start;
    gap: 1rem;
    max-width: 32rem;
    padding: 2rem;
  }

  .saved-carts {
    display: grid;
    grid-template-columns: 20rem 1fr;
    align-items: start;
    gap: 2rem;
  }

  .saved-carts h2 {
    margin-block: 0 1rem;
    font-size: 1.25rem;
  }

  .saved-carts__current {
    position: sticky;
    top: 6rem;
    display: grid;
    gap: 1rem;
    padding: 1.5rem;
  }

  .saved-carts__current h2 {
    margin: 0;
  }

  .saved-carts__lines,
  .saved-cart__items {
    display: grid;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }

  .saved-carts__lines li {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
  }

  .saved-carts__qty {
    color: var(--color-accent);
    font-weight: 600;
  }

  .saved-carts__total {
    display: flex;
    justify-content: space-between;
    padding-block-start: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .saved-carts__save {
    display: grid;
    gap: 0.5rem;
  }

  .toasts {
    position: fixed;
    inset-block-end: 1.5rem;
    inset-inline-end: 1.5rem;
    z-index: 100;
    display: grid;
    gap: 0.5rem;
    width: min(24rem, calc(100vw - 2rem));
  }

  .toast {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 0.75rem 0.875rem 1rem;
    border: 1px solid var(--color-border);
    border-inline-start: 4px solid var(--color-accent);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--shadow-card), 0 12px 32px -8px rgb(0 0 0 / 0.18);
    animation: toast-in 0.25s ease-out;
  }

  .toast--error {
    border-inline-start-color: #b42318;
  }

  .toast__text {
    flex: 1;
    margin: 0;
    font-size: 0.9375rem;
    white-space: pre-line;
  }

  button.toast__close {
    flex: none;
    min-height: 0;
    padding: 0 0.375rem;
    border: 0;
    background: transparent;
    color: var(--color-muted);
    font-size: 1.25rem;
    line-height: 1;
  }

  button.toast__close:hover {
    background: transparent;
    color: var(--color-foreground);
  }

  @keyframes toast-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  .confirm-dialog {
    width: min(26rem, calc(100vw - 2rem));
    margin: auto;
    padding: 1.5rem;
    color: var(--color-foreground);
    box-shadow: var(--shadow-card), 0 24px 48px -12px rgb(0 0 0 / 0.25);
  }

  .confirm-dialog[open] {
    animation: toast-in 0.2s ease-out;
  }

  .confirm-dialog::backdrop {
    background: rgb(0 0 0 / 0.4);
  }

  .confirm-dialog p {
    margin: 0 0 1.5rem;
  }

  .confirm-dialog__actions {
    display: flex;
    justify-content: end;
    gap: 0.5rem;
  }

  .confirm-dialog button.confirm-dialog__danger {
    border-color: #b42318;
    background: #b42318;
    color: #fff;
  }

  .confirm-dialog button.confirm-dialog__danger:hover {
    background: #912018;
  }

  @media (prefers-reduced-motion: reduce) {
    .toast,
    .confirm-dialog[open] {
      animation: none;
    }
  }

  .saved-carts__empty {
    padding: 2rem;
    text-align: center;
    color: var(--color-muted);
    border-style: dashed;
  }

  .saved-carts__list {
    display: grid;
    gap: 1rem;
    padding: 0;
    list-style: none;
  }

  .saved-cart {
    padding: 1.5rem;
    transition: box-shadow 0.2s;
  }

  .saved-cart:hover {
    box-shadow: var(--shadow-card);
  }

  .saved-cart__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-block-end: 1rem;
  }

  .saved-cart__meta {
    font-size: 0.8125rem;
  }

  .saved-cart__items {
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    padding: 1rem;
    border-radius: var(--style-border-radius-inputs);
    background: var(--color-background);
  }

  .saved-cart__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-start: 1.25rem;
  }

  .saved-cart__actions .button--danger {
    margin-inline-start: auto;
  }

  .saved-cart__edit {
    display: grid;
    gap: 1rem;
  }

  .saved-cart__field {
    display: grid;
    gap: 0.375rem;
    max-width: 24rem;
  }

  .saved-cart__edit-items {
    display: grid;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .saved-cart__edit-item {
    display: grid;
    grid-template-columns: 1fr 6rem auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.5rem 0.5rem 1rem;
    border-radius: var(--style-border-radius-inputs);
    background: var(--color-background);
  }

  @media (max-width: 989px) {
    .saved-carts {
      grid-template-columns: 1fr;
    }

    .saved-carts__current {
      position: static;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.saved_carts",
  "settings": []
}
{% endschema %}
