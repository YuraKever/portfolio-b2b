<header class="header full-width">
  <div class="header__inner">
    <a class="header__logo" href="{{ routes.root_url }}">{{ shop.name }}</a>

    <nav class="header__menu" aria-label="{{ 'header.menu' | t }}">
      {% for link in section.settings.menu.links %}
        <a
          href="{{ link.url }}"
          {% if link.active %}
            aria-current="page"
          {% endif %}
        >
          {{- link.title -}}
        </a>
      {% endfor %}
    </nav>

    <div class="header__actions">
      {% if customer.b2b? and settings.saved_carts_page != blank %}
        <a class="header__pill" href="{{ settings.saved_carts_page.url }}">
          {{ 'header.saved_carts' | t }}
        </a>
      {% endif %}

      {% if shop.customer_accounts_enabled %}
        <a class="header__icon" href="{{ routes.account_url }}" aria-label="{{ 'header.account' | t }}">
          {{ 'icon-account.svg' | inline_asset_content }}
        </a>
      {% endif %}

      <a class="header__icon" href="{{ routes.cart_url }}" aria-label="{{ 'header.cart' | t: count: cart.item_count }}">
        {{ 'icon-cart.svg' | inline_asset_content }}
        {% if cart.item_count > 0 %}
          <span class="header__count" aria-hidden="true">{{ cart.item_count }}</span>
        {% endif %}
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .shopify-section-group-header-group {
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .header {
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-background) 85%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    width: var(--content-width);
    height: 4.5rem;
    margin-inline: auto;
  }

  .header__logo {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .header__menu {
    display: flex;
    gap: 1.5rem;
    flex: 1;
    overflow-x: auto;
  }

  .header__menu a {
    color: var(--color-muted);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .header__menu a:hover,
  .header__menu a[aria-current] {
    color: var(--color-foreground);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-inline-start: auto;
  }

  .header__pill {
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .header__icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    color: var(--color-foreground);
  }

  .header__icon:hover {
    background: var(--color-surface);
  }

  .header__icon svg {
    width: 1.5rem;
  }

  .header__count {
    position: absolute;
    top: 0.125rem;
    right: 0.125rem;
    min-width: 1.125rem;
    height: 1.125rem;
    padding-inline: 0.25rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.125rem;
    text-align: center;
  }

  @media (max-width: 749px) {
    .header__inner {
      flex-wrap: wrap;
      gap: 0 1rem;
      height: auto;
      padding-block: 0.75rem;
    }

    .header__menu {
      order: 3;
      flex-basis: 100%;
      padding-block: 0.5rem 0.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    }
  ]
}
{% endschema %}
