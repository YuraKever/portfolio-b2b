{% comment %}
  This section is used in the collection template to render collection page
  listing all products within a collection.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<div class="collection-header">
  <div>
    <h1>{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <div class="collection-header__description muted">{{ collection.description }}</div>
    {% endif %}
  </div>

  <form class="collection-header__sort" method="get">
    <label for="SortBy">{{ 'collections.sort_by' | t }}</label>
    <select id="SortBy" name="sort_by" onchange="this.form.submit()">
      {% for option in collection.sort_options %}
        <option
          value="{{ option.value }}"
          {% if option.value == collection.sort_by %}
            selected
          {% endif %}
        >
          {{ option.name }}
        </option>
      {% endfor %}
    </select>
    <noscript><button type="submit">{{ 'collections.apply' | t }}</button></noscript>
  </form>
</div>

{% paginate collection.products by 24 %}
  <p class="collection-count muted">{{ 'collections.product_count' | t: count: collection.products_count }}</p>

  <ul class="product-grid">
    {% for product in collection.products %}
      <li>{% render 'product-card', product: product %}</li>
    {% else %}
      <li class="muted">{{ 'collections.empty' | t }}</li>
    {% endfor %}
  </ul>

  {% if paginate.pages > 1 %}
    <nav class="pagination" aria-label="{{ 'collections.pagination' | t }}">
      {{ paginate | default_pagination }}
    </nav>
  {% endif %}
{% endpaginate %}

{% stylesheet %}
  .collection-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .collection-header__description {
    max-width: 40rem;
  }

  .collection-header__sort {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-block-end: 1.5rem;
  }

  .collection-count {
    margin-block: 0.5rem 1.25rem;
    font-size: 0.875rem;
  }

  .pagination {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-block-start: 2.5rem;
  }

  .pagination :is(a, span) {
    display: inline-grid;
    place-items: center;
    min-width: 2.5rem;
    height: 2.5rem;
    padding-inline: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    color: inherit;
    text-decoration: none;
  }

  .pagination .current {
    background: var(--color-foreground);
    color: var(--color-background);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": []
}
{% endschema %}
